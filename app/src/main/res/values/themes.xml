<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only, true black. Compose draws everything; this theme only governs the window before it. -->
    <style name="Theme.Siderea" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/siderea_black</item>
        <item name="android:colorBackground">@color/siderea_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
