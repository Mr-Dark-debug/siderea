root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_code_style = ktlint_official
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_filename = enabled
# Compose parameter lists read better with one parameter per line, which ktlint_official enforces.
ktlint_standard_function-signature = enabled

[*.{yml,yaml,json,xml,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
